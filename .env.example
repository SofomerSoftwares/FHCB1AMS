# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database Connection (Primary Default Engine)
MONGODB_URI="mongodb://127.0.0.1:27017/archivetrack_ethiopia"

# MySQL / MySQLi Relational Database Connection (Optional Secondary)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="ROOT@12345"
MYSQL_DATABASE="archivetrack_ethiopia"

# JWT Secret for server session cookies
JWT_SECRET="archivetrack_secure_session_secret_key_change_in_production"
PORT=3000
